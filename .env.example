# ── Vercel'de bunları ELLE girmene gerek yok ──────────────────────────────
# Vercel'de Supabase entegrasyonunu eklediğinde bu değişkenler OTOMATİK gelir
# ve uygulama ilk açılışta veritabanı şemasını kendisi kurar. Bu dosya yalnız
# yerel geliştirme (npm run dev) içindir.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Never expose to the client.
# Excel importer + kullanıcı yönetimi + ilk kurulum için kullanılır.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Doğrudan Postgres bağlantısı — şemanın ilk açılışta otomatik kurulması için.
# Supabase > Project Settings > Database > Connection string (URI / non-pooling).
# Vercel-Supabase entegrasyonu bunu POSTGRES_URL_NON_POOLING olarak otomatik verir.
POSTGRES_URL_NON_POOLING=postgresql://postgres:[PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres
